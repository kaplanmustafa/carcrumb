{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // App code: no Node/Jest globals (tests use tsconfig.test.json).
    "types": []
  },
  // Keeps expo/tsconfig.base's excludes (an exclude here replaces them) and adds tests.
  "exclude": [
    "node_modules",
    ".claude",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}

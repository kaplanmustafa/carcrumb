{
  "expo": {
    "name": "CarCrumb",
    "slug": "carcrumb",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "app.carcrumb.ios",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CarCrumb, aracını park ettiğin yeri ve yolculuklarını kaydetmek için konumunu kullanır. Veriler yalnızca bu cihazda kalır.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CarCrumb, uygulama kapalıyken de yolculuklarını ve park yerini otomatik kaydedebilmek için konumunu her zaman kullanır. Veriler yalnızca bu cihazda kalır.",
        "NSMotionUsageDescription": "CarCrumb, sürüşü ve araçtan inip yürümeye başladığını ayırt etmek için hareket verilerini kullanır.",
        "UIBackgroundModes": [
          "location"
        ],
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": [
          "tr"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ]
    ]
  }
}
